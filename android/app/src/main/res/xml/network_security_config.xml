<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (no user-installed CAs, also in debug builds). The backup client
     additionally pins the server's public keys from the pairing QR code and enforces TLS 1.2+. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
