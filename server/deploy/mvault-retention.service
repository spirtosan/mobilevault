[Unit]
Description=Mobile Vault backup retention (prune old revisions, purge 30-day-old trash)

[Service]
Type=oneshot
User=mvault
Group=mvault
Environment=PYTHONPATH=/opt/mvault
Environment=MVAULT_CONFIG=/etc/mvault/config.json
ExecStart=/usr/bin/python3 -m mvault.admin retention
# Task 11: the trash is root-only, so the purge step runs with full privileges ("+").
ExecStart=+/usr/bin/python3 -m mvault.admin purge-trash
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
IPAddressDeny=any
ReadWritePaths=/mnt/<DATA_DISK>/mobilevault/data
